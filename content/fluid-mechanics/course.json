{
  "id": "fluid-mechanics",
  "title": "流体力学",
  "enTitle": "Fluid Mechanics",
  "icon": "≈",
  "color": "#287b96",
  "description": "从连续介质与守恒基础，走向流动换热仿真：网格、离散、湍流、近壁处理、共轭传热及验证，全流程串联实验与 AI。",
  "prerequisites": [
    "基本力学与单位",
    "单变量微积分；向量基础"
  ],
  "sources": [
    {
      "title": "MIT OCW 2.06 · Fluid Dynamics",
      "url": "https://ocw.mit.edu/courses/2-06-fluid-dynamics-spring-2013/",
      "scope": "本科基础体系：静力、守恒、管流、相似与外流"
    },
    {
      "title": "MIT OCW 2.25 · Advanced Fluid Mechanics",
      "url": "https://ocw.mit.edu/courses/2-25-advanced-fluid-mechanics-fall-2013/pages/calendar/",
      "scope": "连续介质、黏性流、势流、涡量与边界层的进阶结构"
    },
    {
      "title": "MIT OCW 2.29 · Numerical Fluid Mechanics",
      "url": "https://ocw.mit.edu/courses/2-29-numerical-fluid-mechanics-spring-2015/",
      "scope": "数值方法与 CFD 后续学习"
    },
    {
      "title": "MIT 2.20 · Marine Hydrodynamics lecture notes",
      "url": "https://ocw.mit.edu/courses/2-20-marine-hydrodynamics-13-021-spring-2005/pages/lecture-notes/",
      "scope": "逐项核对应力与材料关系、基本势流、镜像法、附加质量及界面边界；不表示覆盖全部海洋工程专题"
    },
    {
      "title": "MIT 1.060 · Engineering Mechanics II lecture notes",
      "url": "https://ocw.mit.edu/courses/1-060-engineering-mechanics-ii-spring-2006/pages/lecture-notes/",
      "scope": "本科静水曲面受力、管流损失与计算练习的主题核对"
    },
    {
      "title": "NASA CFD Verification and Validation",
      "url": "https://www.grc.nasa.gov/www/wind/valid/tutorial/tutorial.html",
      "scope": "验证、网格收敛和实验确认"
    },
    {
      "title": "Turbulence Modeling Resource",
      "url": "https://tmbwg.github.io/turbmodels/",
      "scope": "SST、SA 等模型的原始定义与变体"
    },
    {
      "title": "CFD Direct General Principles",
      "url": "https://doc.cfd.direct/notes/cfd-general-principles/",
      "scope": "有限体积、离散、耦合与求解"
    },
    {
      "title": "OpenFOAM Foundation 13 User Guide",
      "url": "https://doc.cfd.direct/openfoam/user-guide-v13/backwardstep",
      "scope": "版本化的软件入门流程；等温流动"
    }
  ],
